# Non-secret defaults for the docker compose stack on Firefly. Secrets and overrides go in .env.
# Hostnames are compose service names; Ollama runs on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=ornith-1.5:35b
EMBED_MODEL=nomic-embed-text
NUM_CTX=32768
STT_URL=http://stt:9000
WEB_PORT=3000
MCP_PORT=8787
MCP_URL=http://dnd-mcp:8787
RULES_DB_PATH=/data/rules.db
GAME_DB_PATH=/data/game.db
