{
  "name": "dnd-companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @dnd/shared build && pnpm -r test",
    "lint": "prettier --check . && pnpm -r lint",
    "typecheck": "pnpm --filter @dnd/shared build && pnpm -r typecheck",
    "format": "prettier --write .",
    "setup:mac": "./scripts/setup-mac.sh",
    "data:import": "pnpm --filter @dnd/shared build && pnpm --filter @dnd/mcp data:import",
    "data:embed": "pnpm --filter @dnd/shared build && pnpm --filter @dnd/mcp data:embed",
    "data:spotcheck": "pnpm --filter @dnd/shared build && pnpm --filter @dnd/mcp data:spotcheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
