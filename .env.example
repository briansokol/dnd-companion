# Copy to .env (git-ignored) for secrets and local overrides.
# Non-secret defaults live in env/${APP_ENV}.env. Precedence, highest first:
# real environment variables, then .env, then env/${APP_ENV}.env.
# Empty values count as unset.

# Which profile to load: mac | firefly
APP_ENV=mac

# Model provider (Ollama native API)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=ornith-1.5:35b
EMBED_MODEL=nomic-embed-text
NUM_CTX=32768

# Speech-to-text (OpenAI-style /v1/audio/transcriptions)
STT_URL=http://localhost:9000

# Services
WEB_PORT=3000
MCP_PORT=8787
MCP_URL=http://localhost:8787

# Data
RULES_DB_PATH=./data/rules.db
GAME_DB_PATH=./data/game.db

# Iteration 2 secrets (set in .env only)
DM_PIN=
PLAYER_PIN=
